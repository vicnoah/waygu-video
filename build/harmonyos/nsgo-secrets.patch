+package harmonyos
+
+import (
+	"bytes"
+	"encoding/base64"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/nsgo-dev/nsgo/internal/driver"
+)
+
+func TestEncryptedSecrets(t *testing.T) {
+	dir := t.TempDir()
+	var storedKey string
+	system := func(candidate string) string {
+		if storedKey == "" {
+			storedKey = candidate
+		}
+		return storedKey
+	}
+	item := driver.SecretItem{Service: "waygu", Account: "source"}
+	store := &encryptedSecrets{dir: dir, key: system}
+	if _, found, err := store.ReadSecret(item); found || err != nil {
+		t.Fatalf("missing secret = %v, %v", found, err)
+	}
+	value := strings.Repeat("fixture-授权-", 1024)
+	if err := store.WriteSecret(item, value); err != nil {
+		t.Fatal(err)
+	}
+	reopened := &encryptedSecrets{dir: dir, key: system}
+	if got, found, err := reopened.ReadSecret(item); got != value || !found || err != nil {
+		t.Fatalf("reopened secret matches = %v, found = %v, err = %v", got == value, found, err)
+	}
+	read := func() ([]byte, string) {
+		t.Helper()
+		files, err := os.ReadDir(dir)
+		if err != nil || len(files) != 1 {
+			t.Fatalf("secret files = %v, %v", files, err)
+		}
+		name := filepath.Join(dir, files[0].Name())
+		sealed, err := os.ReadFile(name)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return sealed, name
+	}
+	sealed, name := read()
+	key, err := base64.StdEncoding.DecodeString(storedKey)
+	if err != nil || len(key) != 32 || bytes.Contains(sealed, []byte("fixture-")) || bytes.Contains(sealed, key) {
+		t.Fatal("secret file contained plaintext or the system key was invalid")
+	}
+	if err := store.WriteSecret(item, value); err != nil {
+		t.Fatal(err)
+	}
+	fresh, _ := read()
+	if bytes.Equal(sealed, fresh) {
+		t.Fatal("writing the same value reused its ciphertext")
+	}
+	fresh[0] ^= 1
+	if err := os.WriteFile(name, fresh, 0600); err != nil {
+		t.Fatal(err)
+	}
+	if _, found, err := reopened.ReadSecret(item); found || err == nil {
+		t.Fatal("read accepted a modified secret")
+	}
+	if err := reopened.WriteSecret(item, "replacement"); err != nil {
+		t.Fatal(err)
+	}
+	if got, found, err := store.ReadSecret(item); got != "replacement" || !found || err != nil {
+		t.Fatalf("replacement read found = %v, err = %v", found, err)
+	}
+	for range 2 {
+		if err := reopened.DeleteSecret(item); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if _, found, err := reopened.ReadSecret(item); found || err != nil {
+		t.Fatalf("deleted secret = %v, %v", found, err)
+	}
+}
+
+func TestEncryptedSecretsSystemKeyUnavailable(t *testing.T) {
+	dir := t.TempDir()
+	store := &encryptedSecrets{dir: dir, key: func(string) string { return "" }}
+	item := driver.SecretItem{Service: "waygu", Account: "source"}
+	if err := store.WriteSecret(item, "fixture"); !errors.Is(err, driver.ErrNoSecretStore) {
+		t.Fatalf("write without a system key: %v", err)
+	}
+	if files, err := os.ReadDir(dir); err != nil || len(files) != 0 {
+		t.Fatalf("files after refused write = %v, %v", files, err)
+	}
+	store.key = func(candidate string) string { return candidate }
+	if err := store.WriteSecret(item, "fixture"); err != nil {
+		t.Fatal(err)
+	}
+}
