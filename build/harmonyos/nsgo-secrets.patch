+package harmonyos
+
+import (
+	"crypto/aes"
+	"crypto/cipher"
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"errors"
+	"os"
+	"path/filepath"
+	"strconv"
+	"sync"
+
+	"github.com/nsgo-dev/nsgo/internal/driver"
+)
+
+// The system Asset Store keeps the key. The ArkWeb sandbox holds only
+// authenticated ciphertext, including when a value exceeds the asset size limit.
+type encryptedSecrets struct {
+	dir  string
+	key  func(candidate string) string
+	mu   sync.Mutex
+	aead cipher.AEAD
+}
+
+func (s *encryptedSecrets) cipher() (cipher.AEAD, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.aead != nil {
+		return s.aead, nil
+	}
+	var candidate [32]byte
+	rand.Read(candidate[:])
+	response := s.key(base64.StdEncoding.EncodeToString(candidate[:]))
+	key, err := base64.StdEncoding.DecodeString(response)
+	if err != nil || len(key) != len(candidate) {
+		return nil, driver.ErrNoSecretStore
+	}
+	defer clear(key)
+	block, err := aes.NewCipher(key)
+	if err != nil {
+		return nil, err
+	}
+	s.aead, err = cipher.NewGCMWithRandomNonce(block)
+	return s.aead, err
+}
+
+func secretDigest(item driver.SecretItem) [32]byte {
+	return sha256.Sum256([]byte(strconv.Itoa(len(item.Service)) + ":" + item.Service + item.Account))
+}
+
+func (s *encryptedSecrets) ReadSecret(item driver.SecretItem) (string, bool, error) {
+	digest := secretDigest(item)
+	sealed, err := os.ReadFile(filepath.Join(s.dir, hex.EncodeToString(digest[:])))
+	if errors.Is(err, os.ErrNotExist) {
+		return "", false, nil
+	}
+	if err != nil {
+		return "", false, err
+	}
+	aead, err := s.cipher()
+	if err != nil {
+		return "", false, err
+	}
+	value, err := aead.Open(nil, nil, sealed, digest[:])
+	if err != nil {
+		return "", false, err
+	}
+	return string(value), true, nil
+}
+
+func (s *encryptedSecrets) WriteSecret(item driver.SecretItem, value string) error {
+	aead, err := s.cipher()
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(s.dir, 0700); err != nil {
+		return err
+	}
+	f, err := os.CreateTemp(s.dir, ".secret-")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(f.Name())
+	digest := secretDigest(item)
+	if _, err := f.Write(aead.Seal(nil, nil, []byte(value), digest[:])); err != nil {
+		f.Close()
+		return err
+	}
+	if err := f.Sync(); err != nil {
+		f.Close()
+		return err
+	}
+	if err := f.Close(); err != nil {
+		return err
+	}
+	return os.Rename(f.Name(), filepath.Join(s.dir, hex.EncodeToString(digest[:])))
+}
+
+func (s *encryptedSecrets) DeleteSecret(item driver.SecretItem) error {
+	digest := secretDigest(item)
+	err := os.Remove(filepath.Join(s.dir, hex.EncodeToString(digest[:])))
+	if errors.Is(err, os.ErrNotExist) {
+		return nil
+	}
+	return err
+}
