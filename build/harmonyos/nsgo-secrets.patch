+  secretKey(candidate: string): string {
+    const codec = new util.Base64Helper();
+    const alias = new util.TextEncoder().encodeInto('nsgo-encrypted-secrets-key-v1');
+    const query: asset.AssetMap = new Map();
+    query.set(asset.Tag.ALIAS, alias);
+    query.set(asset.Tag.RETURN_TYPE, asset.ReturnType.ALL);
+    try {
+      const value = codec.decodeSync(candidate);
+      if (value.length !== 32) {
+        return '';
+      }
+      // An existing key must survive application restarts and concurrent starts.
+      const attributes: asset.AssetMap = new Map();
+      attributes.set(asset.Tag.SECRET, value);
+      attributes.set(asset.Tag.ALIAS, alias);
+      try {
+        asset.addSync(attributes);
+      } catch (err) {
+        if ((err as BusinessError).code !== asset.ErrorCode.DUPLICATED) {
+          return '';
+        }
+      }
+      const result = asset.querySync(query);
+      const key = result[0]?.get(asset.Tag.SECRET);
+      return key instanceof Uint8Array && key.length === 32 ? codec.encodeToStringSync(key) : '';
+    } catch {
+      return '';
+    }
+  }
