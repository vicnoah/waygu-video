+    private boolean focusFirstTvControl(KeyEvent event) {
+        if (event.getAction() != KeyEvent.ACTION_DOWN || !event.hasNoModifiers() || !isFocused()
+                || !isTelevision()) return false;
+        int key = event.getKeyCode();
+        switch (key) {
+            case KeyEvent.KEYCODE_DPAD_UP:
+            case KeyEvent.KEYCODE_DPAD_DOWN:
+            case KeyEvent.KEYCODE_DPAD_LEFT:
+            case KeyEvent.KEYCODE_DPAD_RIGHT:
+                break;
+            default:
+                return false;
+        }
+        // The host encloses every control, so spatial search from its bounds has no outward candidate.
+        View next = android.view.FocusFinder.getInstance().findNextFocus(this, this, FOCUS_FORWARD);
+        if (next == null || next == this || !next.requestFocus()) return false;
+        consumedKeys.add(key);
+        return true;
+    }
