+package apk
+
+import (
+	"encoding/binary"
+	"slices"
+	"strings"
+)
+
+const densityXHigh = 320
+
+type tvBannerFile struct {
+	locale string
+	path   string
+	png    []byte
+}
+
+func (m Manifest) tvBannerFiles() []tvBannerFile {
+	var locales []string
+	for locale, png := range m.TVBanners {
+		if len(png) != 0 && (locale == "" || localeConfig(locale) != nil) {
+			locales = append(locales, locale)
+		}
+	}
+	slices.Sort(locales)
+	files := make([]tvBannerFile, 0, len(locales))
+	for _, locale := range locales {
+		qualifier := ""
+		if locale != "" {
+			qualifier = "-b+" + strings.ReplaceAll(locale, "-", "+")
+		}
+		files = append(files, tvBannerFile{
+			locale: locale,
+			path:   "res/drawable" + qualifier + "-xhdpi-v4/tv_banner.png",
+			png:    m.TVBanners[locale],
+		})
+	}
+	return files
+}
+
+func tvBannerResourceID(m Manifest) uint32 {
+	id := launchStyleID(m)
+	if m.Launch != nil {
+		id += 1 << 16
+		if _, drawables := launchValues(m); len(drawables) > 0 {
+			id++ // The launcher artwork is the first entry of the same drawable type.
+		}
+	}
+	return id
+}
+
+func (m Manifest) tvBannerEntry() resEntry {
+	entry := resEntry{key: "tv_banner"}
+	for _, banner := range m.tvBannerFiles() {
+		config := newConfig()
+		if banner.locale != "" {
+			config = localeConfig(banner.locale)
+		}
+		binary.LittleEndian.PutUint16(config[14:], densityXHigh)
+		binary.LittleEndian.PutUint16(config[24:], 4)
+		entry.values = append(entry.values, resValue{config: config, str: banner.path})
+	}
+	return entry
+}
+
+func (m Manifest) tvBannerProtoEntry() protoEntry {
+	entry := protoEntry{key: "tv_banner"}
+	for _, banner := range m.tvBannerFiles() {
+		var config []byte
+		if banner.locale != "" {
+			config = pbString(config, 3, banner.locale)
+		}
+		config = pbVarint(config, 18, densityXHigh)
+		config = pbVarint(config, 24, 4)
+		png := pbVarint(pbString(nil, 1, banner.path), 2, 1)
+		entry.values = append(entry.values, [2][]byte{config, pbBytes(nil, 5, png)})
+	}
+	return entry
+}
