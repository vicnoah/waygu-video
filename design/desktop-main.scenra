design light device=desktop width=1440 height=1500 name="桌面/主窗口" gap=160
box class="relative flex-1 flex-row bg-[#f4f4f7]" note="窗口默认 1440×900，内容区纵向滚动；此处拉高以展示完整首页"
  use ambient class="absolute top-0 right-0 bottom-0 left-0 h-full"
  use sidebar class="h-full pt-12" home.tap="open desktop-main" movies.tap="open desktop-library" settings.tap="open desktop-settings"
  box class="relative flex-1 gap-9 pb-10" outlet=content
    box class="h-16 flex-row items-center gap-3 px-8 pt-2"
      box class="h-9 flex-row items-center gap-2 rounded-full border border-zinc-900/8 bg-white px-3.5 shadow-sm shadow-black/5" note="切换聚合视图或单个媒体源（Emby / Jellyfin / 飞牛影视 / SMB / WebDAV）"
        box class="size-2 rounded-full bg-emerald-500"
        end
        text "全部媒体源" class="text-sm font-medium text-zinc-900"
        text "3 个在线" class="text-xs text-zinc-500"
        icon chevron-down class="size-4 text-zinc-500"
      end
      box class="flex-1"
      end
      box class="h-9 w-72 flex-row items-center gap-2 rounded-full border border-zinc-900/8 bg-white px-4 shadow-sm shadow-black/5"
        icon search class="size-4 text-zinc-500"
        text "搜索电影、剧集、演员" class="flex-1 text-sm text-zinc-500"
        text "⌘K" class="rounded border border-zinc-900/8 px-1.5 text-[10px] text-zinc-500"
      end
      box class="size-9 items-center justify-center rounded-full border border-zinc-900/8 bg-white shadow-sm shadow-black/5" note="立即与所有媒体源同步媒体库与观看进度"
        icon refresh-cw class="size-4 text-zinc-900/80"
      end
      box class="size-9 items-center justify-center rounded-full border border-zinc-900/8 bg-white shadow-sm shadow-black/5"
        icon bell class="size-4 text-zinc-900/80"
      end
      box class="size-9 items-center justify-center rounded-full bg-linear-to-br from-violet-500 to-fuchsia-500"
        text "林" class="text-sm font-semibold text-white"
      end
    end
    box class="relative mx-8 h-[380px] overflow-hidden rounded-3xl shadow-2xl shadow-black/25" note="首页焦点轮播：取各媒体源最近添加的高分影片，8 秒自动切换"
      image "沙丘2 横版剧照：沙漠中骑乘巨型沙虫的身影，橙色天空" class="absolute top-0 right-0 bottom-0 left-0"
      box class="absolute top-0 right-0 bottom-0 left-0 bg-linear-to-r from-black/90 via-black/50 to-transparent"
      end
      box class="flex-1 w-[600px] justify-end gap-4 p-10"
        box class="flex-row items-center gap-2"
          text "最近添加" class="rounded-full bg-violet-500/20 px-2.5 py-1 text-xs font-medium text-violet-300"
          text "家庭 Emby" class="rounded-full bg-emerald-500/15 px-2.5 py-1 text-xs text-emerald-400"
        end
        text "沙丘2" class="text-5xl font-bold text-white"
        box class="flex-row items-center gap-3"
          text "2024" class="text-sm text-zinc-300"
          text "科幻 / 冒险" class="text-sm text-zinc-300"
          text "2 小时 46 分" class="text-sm text-zinc-300"
          text "4K 杜比视界" class="rounded border border-white/30 px-1.5 text-[11px] font-semibold text-white"
          text "Atmos" class="rounded border border-white/30 px-1.5 text-[11px] font-semibold text-white"
        end
        text "保罗·厄崔迪与契妮及弗雷曼人联手，踏上向毁灭其家族的阴谋者复仇之路，同时必须在挚爱与已知宇宙的命运之间做出抉择。" class="line-clamp-2 text-sm leading-relaxed text-zinc-300"
        box class="flex-row gap-3 pt-1"
          box class="h-11 flex-row items-center gap-2 rounded-full bg-violet-500 px-6 shadow-lg shadow-violet-500/40" tap="open desktop-player"
            icon play class="size-4 text-white"
            text "播放" class="font-semibold text-white"
          end
          box class="h-11 flex-row items-center gap-2 rounded-full border border-white/20 bg-white/15 px-6" tap="open desktop-movie"
            icon info class="size-4 text-white"
            text "详情" class="font-semibold text-white"
          end
          box class="size-11 items-center justify-center rounded-full bg-white/15"
            icon plus class="size-5 text-white"
          end
        end
      end
      box class="absolute right-8 bottom-8 flex-row gap-1.5"
        box class="h-1.5 w-6 rounded-full bg-white"
        end
        box class="size-1.5 rounded-full bg-white/40"
        end
        box class="size-1.5 rounded-full bg-white/40"
        end
        box class="size-1.5 rounded-full bg-white/40"
        end
      end
    end
    box class="gap-4"
      use section-title class="px-8" title="继续观看"
      box class="flex-row gap-4 overflow-hidden px-8"
        use backdrop-card class="w-72" cover.class="h-40" card.tap="open desktop-player"
        use backdrop-card class="w-72" cover.class="h-40" cover="奥本海默剧照：黑白画面中的科学家特写" title="奥本海默" sub="电影 · 2023" remain="剩余 1 小时 08 分" progress.class="w-1/3" card.tap="open desktop-player"
        use backdrop-card class="w-72" cover.class="h-40" cover="繁花剧照：九十年代上海黄河路霓虹夜景" title="繁花" sub="第 1 季 · 第 14 集" remain="剩余 21 分钟" progress.class="w-1/2" card.tap="open desktop-player"
        use backdrop-card class="w-72" cover.class="h-40" cover="葬送的芙莉莲剧照：精灵魔法使站在花田中" title="葬送的芙莉莲" sub="第 1 季 · 第 20 集" remain="剩余 9 分钟" progress.class="w-4/5" card.tap="open desktop-player"
      end
    end
    box class="gap-4"
      use section-title class="px-8" title="最近添加"
      box class="flex-row gap-4 overflow-hidden px-8"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="沙丘2 海报：沙漠中的主角剪影" title="沙丘2" sub="2024 · 科幻" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="周处除三害 海报：持枪男子侧脸" title="周处除三害" sub="2023 · 犯罪" quality="1080P" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="哥斯拉-1.0 海报：怪兽在废墟中咆哮" title="哥斯拉-1.0" sub="2023 · 科幻" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="热辣滚烫 海报：拳击台上的女主角" title="热辣滚烫" sub="2024 · 剧情" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="你想活出怎样的人生 海报：少年与苍鹭" title="你想活出怎样的人生" sub="2023 · 动画" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="第二十条 海报：法庭前的人群" title="第二十条" sub="2024 · 剧情" quality="1080P" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="飞驰人生2 海报：赛车与车手" title="飞驰人生2" sub="2024 · 喜剧" card.tap="open desktop-movie"
      end
    end
    box class="gap-4"
      use section-title class="px-8" title="剧集更新"
      box class="flex-row gap-4 overflow-hidden px-8"
        use backdrop-card class="w-72" cover.class="h-40" cover="三体剧照：倒计时浮现在夜空中" title="三体" sub="更新至 第 30 集" remain="新剧集" progress.class="w-0"
        use backdrop-card class="w-72" cover.class="h-40" cover="我的阿勒泰剧照：草原上的毡房与马群" title="我的阿勒泰" sub="更新至 第 8 集" remain="新剧集" progress.class="w-0"
        use backdrop-card class="w-72" cover.class="h-40" cover="排球少年剧照：体育馆中跃起扣球" title="排球少年" sub="剧场版 · 新增" remain="新上线" progress.class="w-0"
        use backdrop-card class="w-72" cover.class="h-40" cover="庆余年第二季剧照：古装少年手持折扇" title="庆余年 第二季" sub="更新至 第 36 集" remain="新剧集" progress.class="w-0"
      end
    end
    box class="gap-4"
      box class="flex-row items-center gap-2 px-8"
        text "来自飞牛影视" class="text-lg font-bold text-zinc-900"
        text "fnOS" class="rounded bg-blue-500/15 px-1.5 py-0.5 text-[11px] font-medium text-blue-500"
        box class="flex-1"
        end
        text "全部" class="text-sm text-zinc-500"
        icon chevron-right class="size-4 text-zinc-500"
      end
      box class="flex-row gap-4 overflow-hidden px-8"
        use poster class="w-36" cover.class="h-52" variant=plain cover="长安三万里 海报：骑马的诗人与长安城" title="长安三万里" sub="2023 · 动画" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=watched cover="流浪地球2 海报：太空电梯与宇航员" title="流浪地球2" sub="2023 · 科幻" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=plain cover="满江红 海报：古城墙下的群像" title="满江红" sub="2023 · 悬疑" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=plain cover="宇宙探索编辑部 海报：戴锅盖天线的中年人" title="宇宙探索编辑部" sub="2023 · 喜剧" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=watched cover="隐入尘烟 海报：农田里的一对夫妻" title="隐入尘烟" sub="2022 · 剧情" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=plain cover="封神第一部 海报：金甲战士与火焰" title="封神第一部" sub="2023 · 奇幻" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=plain cover="独行月球 海报：月球上的宇航员与袋鼠" title="独行月球" sub="2022 · 喜剧" card.tap="open desktop-movie"
      end
    end
  end
  box class="absolute top-4 left-4 flex-row gap-2"
    box class="size-3 rounded-full bg-[#ff5f57]"
    end
    box class="size-3 rounded-full bg-[#febc2e]"
    end
    box class="size-3 rounded-full bg-[#28c840]"
    end
  end
end

