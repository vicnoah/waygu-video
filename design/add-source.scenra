      box class="flex-row items-center gap-3 rounded-xl border border-white/8 bg-[#1a1b25] p-3 shadow-sm shadow-black/5"
        box class="size-9 items-center justify-center rounded-lg bg-blue-500/15"
          icon hard-drive class="size-4 text-blue-500"
        end
        box class="flex-1"
          text "fnOS 飞牛 NAS" class="text-sm font-medium text-zinc-50"
          text "飞牛影视 · 192.168.1.8:5666" class="text-xs text-zinc-400"
        end
        box class="rounded-full bg-violet-500 px-3.5 py-1.5 shadow-md shadow-violet-500/30" tap="open source-login#dark"
          text "添加" class="text-xs font-semibold text-white"
        end
      end
    end
    use settings-group-dark header="媒体服务器"
      fill
        use settings-row-dark title="Emby" icon=server badge.class="bg-emerald-500" value.class="hidden" row.tap="open source-login#dark"
        use settings-row-dark title="Jellyfin" icon=server badge.class="bg-sky-500" value.class="hidden" row.tap="open source-login#dark"
        use settings-row-dark title="飞牛影视" icon=hard-drive badge.class="bg-blue-500" value="fnOS" row.tap="open source-login#dark"
        use settings-row-dark title="Plex" icon=server badge.class="bg-amber-500" value.class="hidden" row.tap="open source-login#dark"
      end
    end
    use settings-group-dark header="网络共享"
      fill
        use settings-row-dark title="SMB / Windows 共享" icon=folder-tree badge.class="bg-slate-500" value.class="hidden"
        use settings-row-dark title="WebDAV" icon=globe badge.class="bg-slate-500" value.class="hidden"
        use settings-row-dark title="NFS" icon=network badge.class="bg-slate-500" value.class="hidden"
        use settings-row-dark title="FTP / SFTP" icon=folder-up badge.class="bg-slate-500" value.class="hidden"
      end
    end
    use settings-group-dark header="网盘" variant=footer footer="网盘通过官方开放接口或 Alist / WebDAV 挂载接入，播放直连网盘原画链接。"
      fill
        use settings-row-dark title="阿里云盘" icon=cloud badge.class="bg-orange-500" value.class="hidden"
        use settings-row-dark title="115 网盘" icon=cloud badge.class="bg-sky-600" value.class="hidden"
        use settings-row-dark title="百度网盘" icon=cloud badge.class="bg-blue-600" value="Alist"
      end
    end
    use settings-group-dark variant=noheader class="pb-10"
      fill
        use settings-row-dark title="本机文件" icon=smartphone badge.class="bg-slate-500" value="文件 App"
      end
    end
  end
end
