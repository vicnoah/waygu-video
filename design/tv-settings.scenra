    box class="gap-2.5"
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "显示弹幕" class="flex-1 text-2xl text-zinc-50"
        use switch-dark class="h-[40px] w-[68px]" knob.class="size-[34px]"
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5" note="弹幕来源的启用与优先级在手机或电脑端 设置 › 弹幕 中管理，通过 iCloud / Waygu 账户同步"
        text "弹幕来源" class="flex-1 text-2xl text-zinc-50"
        text "弹弹play · B站 · 本地 XML" class="text-2xl text-zinc-400"
        icon chevron-right class="size-6 text-zinc-400/70"
      end
      box class="gap-4 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 py-5 shadow-sm shadow-black/5"
        box class="flex-row items-center justify-between"
          text "不透明度" class="text-2xl text-zinc-50"
