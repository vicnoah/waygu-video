      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "滚动速度" class="flex-1 text-2xl text-zinc-50"
        icon chevron-left class="size-6 text-zinc-400/70"
        text "适中" class="w-24 text-center text-2xl text-zinc-50/80"
        icon chevron-right class="size-6 text-zinc-400/70"
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl bg-zinc-50 px-7 shadow-2xl shadow-violet-500/30 ring-4 ring-violet-500" note="当前焦点项（反色背景 + 紫色描边并轻微放大）：左右键在四档间切换"
        text "显示区域" class="flex-1 text-2xl font-semibold text-[#0f1017]"
        box class="flex-row gap-1.5 rounded-full bg-[#0f1017]/15 p-1"
          box class="rounded-full px-5 py-1.5"
            text "1/4 屏" class="text-xl text-[#0f1017]/70"
          end
          box class="rounded-full bg-violet-500 px-5 py-1.5 shadow-md"
            text "半屏" class="text-xl font-semibold text-white"
          end
          box class="rounded-full px-5 py-1.5"
            text "3/4 屏" class="text-xl text-[#0f1017]/70"
          end
          box class="rounded-full px-5 py-1.5"
            text "全屏" class="text-xl text-[#0f1017]/70"
          end
        end
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "同屏密度" class="flex-1 text-2xl text-zinc-50"
        icon chevron-left class="size-6 text-zinc-400/70"
        text "中" class="w-24 text-center text-2xl text-zinc-50/80"
        icon chevron-right class="size-6 text-zinc-400/70"
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "合并重复弹幕" class="flex-1 text-2xl text-zinc-50"
        use switch-dark class="h-[40px] w-[68px]" knob.class="size-[34px]"
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "屏蔽顶部 / 底部弹幕" class="flex-1 text-2xl text-zinc-50"
        use switch-dark variant=off class="h-[40px] w-[68px]" knob.class="size-[34px]"
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "屏蔽关键词" class="flex-1 text-2xl text-zinc-50"
        text "12 条规则" class="text-2xl text-zinc-400"
        icon chevron-right class="size-6 text-zinc-400/70"
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5" note="弹幕与画面不同步时调整，按剧集记忆"
        text "时间轴偏移" class="flex-1 text-2xl text-zinc-50"
        icon chevron-left class="size-6 text-zinc-400/70"
        text "+0.0 秒" class="w-28 text-center text-2xl text-zinc-50/80"
        icon chevron-right class="size-6 text-zinc-400/70"
      end
    end
  end
end
