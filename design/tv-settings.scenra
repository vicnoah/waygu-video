        end
        box class="h-6 flex-row items-center"
          box class="h-2 w-4/5 rounded-l-full bg-violet-500"
          end
          box class="size-6 rounded-full border border-black/5 bg-white shadow-md"
          end
          box class="h-2 flex-1 rounded-r-full bg-zinc-50/10"
          end
        end
      end
      box class="h-[68px] flex-row items-center gap-5 rounded-2xl border border-white/8 bg-[#1a1b25] px-7 shadow-sm shadow-black/5"
        text "字号" class="flex-1 text-2xl text-zinc-50"
        icon chevron-left class="size-6 text-zinc-400/70"
        text "标准" class="w-24 text-center text-2xl text-zinc-50/80"
        icon chevron-right class="size-6 text-zinc-400/70"
