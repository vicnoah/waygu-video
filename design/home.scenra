        box class="w-36 gap-3 rounded-2xl border border-white/8 bg-[#1a1b25] p-3.5 shadow-sm shadow-black/5"
          box class="flex-row items-center justify-between"
            box class="size-9 items-center justify-center rounded-xl bg-sky-500/15"
