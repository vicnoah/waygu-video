    box class="gap-3"
      use section-title-dark title="按媒体源" variant=bare
      box class="flex-row gap-2.5 overflow-hidden px-5"
        box class="w-36 gap-3 rounded-2xl border border-white/8 bg-[#1a1b25] p-3.5 shadow-sm shadow-black/5"
          box class="flex-row items-center justify-between"
            box class="size-9 items-center justify-center rounded-xl bg-emerald-500/15"
              icon server class="size-4 text-emerald-500"
            end
            box class="size-2 rounded-full bg-emerald-500"
            end
          end
          box class="gap-0.5"
            text "家庭 Emby" class="text-sm font-semibold text-zinc-50"
            text "Emby · 1,620 项" class="text-[11px] text-zinc-400"
