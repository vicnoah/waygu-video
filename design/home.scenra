            text "书房 NAS" class="text-sm font-semibold text-zinc-50"
            text "Jellyfin · 842 项" class="text-[11px] text-zinc-400"
          end
        end
        box class="w-36 gap-3 rounded-2xl border border-white/8 bg-[#1a1b25] p-3.5 shadow-sm shadow-black/5"
          box class="flex-row items-center justify-between"
            box class="size-9 items-center justify-center rounded-xl bg-blue-500/15"
              icon database class="size-4 text-blue-500"
            end
            box class="size-2 rounded-full bg-amber-500"
            end
          end
          box class="gap-0.5"
            text "飞牛影视" class="text-sm font-semibold text-zinc-50"
            text "fnOS · 同步中" class="text-[11px] text-zinc-400"
          end
