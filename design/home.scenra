        box class="flex-row items-center gap-2"
          box class="h-8 flex-row items-center gap-1.5 rounded-full border border-white/8 bg-[#1a1b25]/80 px-3 shadow-sm shadow-black/5" note="切换只看某一媒体源，或合并显示全部媒体源的内容"
