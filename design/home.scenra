            box class="h-11 flex-1 flex-row items-center justify-center gap-2 rounded-xl bg-white/20" tap="open movie-detail#dark"
              icon info class="size-4 text-white"
              text "详情" class="text-sm font-semibold text-white"
            end
          end
        end
      end
      box class="flex-row justify-center gap-1.5" note="首页大图每 8 秒轮播最近入库的高分影片"
        box class="h-1.5 w-5 rounded-full bg-violet-500"
        end
        box class="size-1.5 rounded-full bg-zinc-50/20"
        end
        box class="size-1.5 rounded-full bg-zinc-50/20"
        end
        box class="size-1.5 rounded-full bg-zinc-50/20"
        end
