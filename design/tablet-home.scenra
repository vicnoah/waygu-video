design light device=tablet width=1180 height=820 name="平板/首页" gap=140
box class="relative flex-1 bg-[#f4f4f7]"
  use ambient class="absolute top-0 right-0 bottom-0 left-0 h-full"
  box class="h-6 flex-row items-center justify-between px-6"
    text "9:41  11月19日 周四" class="text-xs font-semibold text-zinc-900"
    box class="flex-row items-center gap-1.5"
      icon wifi class="size-3.5 text-zinc-900"
      text "86%" class="text-xs font-semibold text-zinc-900"
      icon battery-full class="size-4 text-zinc-900"
    end
  end
  box class="flex-1 flex-row"
    use sidebar class="w-56 pt-3" home.tap="open tablet-home" note="竖屏时侧边栏收起为抽屉，左滑呼出"
    box class="flex-1 gap-7 overflow-hidden pt-4 pb-6"
      box class="flex-row items-center justify-between px-6"
        box class="gap-0.5"
          text "下午好，林小雨" class="text-2xl font-bold tracking-tight text-zinc-900"
          text "3 个媒体源在线 · 今天新增 12 部" class="text-sm text-zinc-500"
        end
        box class="h-9 flex-row items-center gap-2 rounded-full border border-zinc-900/8 bg-white px-3.5 shadow-sm shadow-black/5" note="切换聚合视图或单个媒体源"
          box class="size-2 rounded-full bg-emerald-500"
          end
          text "全部媒体源" class="text-sm font-medium text-zinc-900"
          icon chevron-down class="size-4 text-zinc-500"
        end
      end
      box class="relative mx-6 h-[260px] overflow-hidden rounded-3xl shadow-2xl shadow-black/25" note="焦点轮播，左右轻扫切换"
        image "沙丘2 横版剧照：沙漠中骑乘巨型沙虫的身影，橙色天空" class="absolute top-0 right-0 bottom-0 left-0"
        box class="absolute top-0 right-0 bottom-0 left-0 bg-linear-to-r from-black/85 via-black/45 to-transparent"
        end
        box class="flex-1 w-[460px] justify-end gap-3 p-8"
          box class="flex-row items-center gap-2"
            text "新入库" class="rounded-md bg-violet-500 px-1.5 py-0.5 text-[11px] font-bold text-white"
            text "家庭 Emby" class="text-xs font-medium text-white/80"
          end
          text "沙丘2" class="text-4xl font-bold tracking-tight text-white"
          text "2024 · 科幻 / 冒险 · 2 小时 46 分 · 4K 杜比视界" class="text-sm text-white/80"
          box class="flex-row gap-3 pt-1"
            box class="h-10 flex-row items-center gap-2 rounded-full bg-white px-5 shadow-lg" tap="open player"
              icon play class="size-4 text-black"
              text "播放" class="text-sm font-semibold text-black"
            end
            box class="h-10 flex-row items-center gap-2 rounded-full bg-white/20 px-5" tap="open tablet-detail"
              icon info class="size-4 text-white"
              text "详情" class="text-sm font-semibold text-white"
            end
          end
        end
        box class="absolute right-6 bottom-6 flex-row gap-1.5"
          box class="h-1.5 w-5 rounded-full bg-white"
          end
          box class="size-1.5 rounded-full bg-white/40"
          end
          box class="size-1.5 rounded-full bg-white/40"
          end
          box class="size-1.5 rounded-full bg-white/40"
          end
        end
      end
      box class="gap-4"
        use section-title class="px-6" title="继续观看"
        box class="flex-row gap-4 overflow-hidden px-6"
          use backdrop-card card.tap="open player"
          use backdrop-card cover="奥本海默剧照：黑白画面中的科学家特写" title="奥本海默" sub="电影 · 2023" remain="剩余 1 小时 08 分" progress.class="w-1/3" card.tap="open player"
          use backdrop-card cover="繁花剧照：九十年代上海黄河路霓虹夜景" title="繁花" sub="第 1 季 · 第 14 集" remain="剩余 21 分钟" progress.class="w-1/2" card.tap="open player"
          use backdrop-card cover="葬送的芙莉莲剧照：精灵魔法使站在花田中" title="葬送的芙莉莲" sub="第 1 季 · 第 20 集" remain="剩余 9 分钟" progress.class="w-4/5" card.tap="open player"
        end
      end
      box class="gap-4"
        use section-title class="px-6" title="最近添加"
        box class="flex-row gap-4 overflow-hidden px-6"
          use poster variant=fresh cover="沙丘2 海报：沙漠中的主角剪影" title="沙丘2" sub="2024 · 科幻" card.tap="open tablet-detail"
          use poster variant=fresh cover="周处除三害 海报：持枪男子侧脸" title="周处除三害" sub="2023 · 犯罪" quality="1080P" card.tap="open tablet-detail"
          use poster variant=fresh cover="哥斯拉-1.0 海报：怪兽在废墟中咆哮" title="哥斯拉-1.0" sub="2023 · 科幻" card.tap="open tablet-detail"
          use poster variant=fresh cover="热辣滚烫 海报：拳击台上的女主角" title="热辣滚烫" sub="2024 · 剧情" card.tap="open tablet-detail"
          use poster variant=fresh cover="你想活出怎样的人生 海报：少年与苍鹭" title="你想活出怎样的人生" sub="2023 · 动画" card.tap="open tablet-detail"
          use poster variant=fresh cover="第二十条 海报：法庭前的人群" title="第二十条" sub="2024 · 剧情" quality="1080P" card.tap="open tablet-detail"
          use poster variant=fresh cover="飞驰人生2 海报：赛车与车手" title="飞驰人生2" sub="2024 · 喜剧" card.tap="open tablet-detail"
        end
      end
    end
  end
end

design dark device=tablet width=1180 height=820 name="首页 · 深色"
