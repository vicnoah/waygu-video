        box class="w-16 items-center gap-1.5"
          image "演员基里安·墨菲的头像" class="size-16 rounded-full border-2 border-[#1a1b25] shadow-md shadow-black/10"
          text "基里安·墨菲" class="w-full truncate text-center text-[11px] text-zinc-50"
          text "演员 · 5 部" class="text-[10px] text-zinc-400"
        end
        box class="w-16 items-center gap-1.5"
          image "演员迈克尔·凯恩的头像" class="size-16 rounded-full border-2 border-[#1a1b25] shadow-md shadow-black/10"
          text "迈克尔·凯恩" class="w-full truncate text-center text-[11px] text-zinc-50"
