        box class="h-10 flex-row items-center gap-3 bg-[#1a1b25] px-4" note="根据网络环境在内网 / 外网地址间自动选择延迟最低的一个"
          text "自动切换线路" class="flex-1 text-sm text-zinc-50"
          use switch-dark class="h-[22px] w-[38px]" knob.class="size-[18px]"
        end
        box class="h-10 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "用户" class="w-20 text-sm text-zinc-400"
          text "xiaoyu" class="flex-1 text-sm text-zinc-50"
          text "切换用户" class="text-xs text-violet-400"
        end
        box class="h-10 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "同步观看进度" class="flex-1 text-sm text-zinc-50"
          use switch-dark class="h-[22px] w-[38px]" knob.class="size-[18px]"
        end
        box class="h-10 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "外网最大码率" class="flex-1 text-sm text-zinc-50"
          use select-dark label="20 Mbps · 1080p 转码"
        end
      end
      box class="w-60 gap-1 rounded-xl border border-white/8 bg-[#1a1b25] shadow-sm shadow-black/5 p-4" note="取消勾选的媒体库不出现在首页、搜索与推荐中"
        text "显示的媒体库" class="pb-2 text-sm font-medium text-zinc-50"
        box class="h-8 flex-row items-center gap-2.5"
          box class="size-4 items-center justify-center rounded bg-violet-500"
            icon check class="size-3 text-white"
          end
          text "电影" class="text-sm text-zinc-50/80"
        end
        box class="h-8 flex-row items-center gap-2.5"
          box class="size-4 items-center justify-center rounded bg-violet-500"
            icon check class="size-3 text-white"
          end
          text "电视剧" class="text-sm text-zinc-50/80"
        end
        box class="h-8 flex-row items-center gap-2.5"
          box class="size-4 items-center justify-center rounded bg-violet-500"
            icon check class="size-3 text-white"
          end
          text "动漫" class="text-sm text-zinc-50/80"
        end
        box class="h-8 flex-row items-center gap-2.5"
          box class="size-4 items-center justify-center rounded bg-violet-500"
            icon check class="size-3 text-white"
          end
          text "纪录片" class="text-sm text-zinc-50/80"
