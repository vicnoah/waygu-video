      box class="w-20 flex-row"
        text "SMB" class="rounded bg-zinc-50/10 px-1.5 py-0.5 text-[11px] text-zinc-50/80"
      end
      text "smb://192.168.1.20/Movies" class="flex-1 truncate text-sm text-zinc-50/80"
      text "2" class="w-14 text-sm text-zinc-50/80"
      box class="w-16 flex-row items-center gap-1.5"
        box class="size-1.5 rounded-full bg-emerald-500"
        end
        text "在线" class="text-xs text-emerald-500"
      end
      box class="w-14 flex-row justify-end gap-3"
        icon pencil class="size-4 text-zinc-400"
        icon trash class="size-4 text-zinc-400"
      end
    end
    box class="h-10 flex-row items-center gap-3 border-t border-white/8 px-4"
      text "Alist 阿里云盘" class="w-40 text-sm text-zinc-50"
      box class="w-20 flex-row"
        text "WebDAV" class="rounded bg-zinc-50/10 px-1.5 py-0.5 text-[11px] text-zinc-50/80"
      end
      text "https://alist.example.com/dav" class="flex-1 truncate text-sm text-zinc-50/80"
      text "1" class="w-14 text-sm text-zinc-50/80"
      box class="w-16 flex-row items-center gap-1.5"
        box class="size-1.5 rounded-full bg-zinc-400/50"
        end
        text "离线" class="text-xs text-zinc-400"
      end
      box class="w-14 flex-row justify-end gap-3"
        icon pencil class="size-4 text-zinc-400"
        icon trash class="size-4 text-zinc-400"
