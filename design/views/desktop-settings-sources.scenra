    text "家庭 Emby · 连接与同步" class="px-1 text-xs font-medium text-zinc-400"
    box class="flex-row gap-4"
      box class="flex-1 gap-px overflow-hidden rounded-xl border border-white/8 bg-white/7 shadow-sm shadow-black/5"
        box class="h-10 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "内网地址" class="w-20 text-sm text-zinc-400"
          text "http://192.168.1.10:8096" class="flex-1 truncate text-sm text-zinc-50"
        end
        box class="h-10 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "外网地址" class="w-20 text-sm text-zinc-400"
          text "https://emby.example.com" class="flex-1 truncate text-sm text-zinc-50"
