          end
          box class="gap-1"
            text "编剧" class="text-xs text-zinc-400"
            text "丹尼斯·维伦纽瓦 / 乔·斯派茨" class="text-sm text-zinc-50"
          end
          box class="gap-1"
            text "制片国家" class="text-xs text-zinc-400"
            text "美国 / 加拿大" class="text-sm text-zinc-50"
          end
        end
      end
      box class="gap-4"
        text "演职人员" class="text-lg font-bold text-zinc-50"
        box class="flex-row gap-5 overflow-hidden"
