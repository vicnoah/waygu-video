        end
        box class="h-11 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "夜间模式（动态压缩）" class="flex-1 text-sm text-zinc-50"
          use switch-dark variant=off class="h-[22px] w-[38px]" knob.class="size-[18px]"
        end
      end
      text "播放行为" class="px-1 pt-3 text-xs font-medium text-zinc-400"
      box class="gap-px overflow-hidden rounded-xl border border-white/8 bg-white/7 shadow-sm shadow-black/5"
        box class="h-11 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "自动播放下一集" class="flex-1 text-sm text-zinc-50"
          use select-dark label="倒计时 10 秒"
        end
        box class="h-11 flex-row items-center gap-3 bg-[#1a1b25] px-4" note="使用媒体源的片头/片尾章节标记，没有时按同季其他集推断"
          text "跳过片头片尾" class="flex-1 text-sm text-zinc-50"
          use select-dark label="显示跳过按钮"
        end
        box class="h-11 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "快退 / 快进步长" class="flex-1 text-sm text-zinc-50"
          use select-dark label="10 秒 / 10 秒"
        end
        box class="h-11 flex-row items-center gap-3 bg-[#1a1b25] px-4"
          text "记住每部影片的音轨与字幕" class="flex-1 text-sm text-zinc-50"
