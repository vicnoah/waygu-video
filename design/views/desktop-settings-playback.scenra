      box class="gap-px overflow-hidden rounded-xl border border-white/8 bg-white/7 shadow-sm shadow-black/5"
        box class="h-11 flex-row items-center gap-3 bg-[#1a1b25] px-4" note="内置 mpv 支持几乎所有格式与特效字幕；系统 AVPlayer 更省电，支持杜比视界原生输出"
          text "播放器内核" class="flex-1 text-sm text-zinc-50"
