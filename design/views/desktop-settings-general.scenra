design light in="desktop-settings#light/page" name="设置窗口/通用" gap=160
box class="relative flex-1 gap-5 bg-[#f4f4f7] p-8"
  use ambient class="absolute top-0 right-0 bottom-0 left-0 h-full"
  box class="gap-1"
    text "通用" class="text-2xl font-bold text-zinc-900"
    text "语言、外观、启动行为与更新" class="text-sm text-zinc-500"
  end
  box class="gap-2"
    text "基本" class="px-1 text-xs font-medium text-zinc-500"
    box class="gap-px overflow-hidden rounded-xl border border-zinc-900/8 bg-zinc-200 shadow-sm shadow-black/5"
      box class="h-12 flex-row items-center gap-4 bg-white px-4"
        text "界面语言" class="flex-1 text-sm text-zinc-900"
        use select label="简体中文"
      end
      box class="h-12 flex-row items-center gap-4 bg-white px-4"
        text "主题" class="flex-1 text-sm text-zinc-900"
        box class="h-7 flex-row rounded-md bg-zinc-900/5 p-0.5"
          box class="items-center justify-center rounded px-3"
            text "跟随系统" class="text-xs text-zinc-500"
          end
          box class="items-center justify-center rounded bg-white shadow-sm px-3"
            text "深色" class="text-xs font-medium text-zinc-900"
          end
          box class="items-center justify-center rounded px-3"
            text "浅色" class="text-xs text-zinc-500"
          end
        end
      end
      box class="h-14 flex-row items-center gap-4 bg-white px-4"
        box class="flex-1 gap-0.5"
          text "默认媒体源" class="text-sm text-zinc-900"
          text "首页与媒体库默认显示的内容来源" class="text-xs text-zinc-500"
        end
        use select label="全部媒体源（聚合）"
      end
    end
  end
  box class="gap-2"
    text "启动" class="px-1 text-xs font-medium text-zinc-500"
    box class="gap-px overflow-hidden rounded-xl border border-zinc-900/8 bg-zinc-200 shadow-sm shadow-black/5"
      box class="h-12 flex-row items-center gap-4 bg-white px-4"
        text "启动时打开" class="flex-1 text-sm text-zinc-900"
        box class="h-7 flex-row rounded-md bg-zinc-900/5 p-0.5"
          box class="items-center justify-center rounded bg-white shadow-sm px-3"
            text "首页" class="text-xs font-medium text-zinc-900"
          end
          box class="items-center justify-center rounded px-3"
            text "上次位置" class="text-xs text-zinc-500"
          end
        end
      end
      box class="h-12 flex-row items-center gap-4 bg-white px-4"
        text "登录时自动启动" class="flex-1 text-sm text-zinc-900"
        use switch variant=off class="h-[22px] w-[38px]" knob.class="size-[18px]"
      end
      box class="h-14 flex-row items-center gap-4 bg-white px-4"
        box class="flex-1 gap-0.5"
          text "在菜单栏显示图标" class="text-sm text-zinc-900"
          text "关闭主窗口后可从菜单栏继续播放、查看下载进度" class="text-xs text-zinc-500"
        end
        use switch class="h-[22px] w-[38px]" knob.class="size-[18px]"
      end
    end
  end
  box class="gap-2"
    text "更新" class="px-1 text-xs font-medium text-zinc-500"
    box class="gap-px overflow-hidden rounded-xl border border-zinc-900/8 bg-zinc-200 shadow-sm shadow-black/5"
      box class="h-12 flex-row items-center gap-4 bg-white px-4"
        text "自动检查并下载更新" class="flex-1 text-sm text-zinc-900"
        use switch class="h-[22px] w-[38px]" knob.class="size-[18px]"
      end
      box class="h-14 flex-row items-center gap-4 bg-white px-4"
        box class="flex-1 gap-0.5"
          text "当前版本 2.4.0 (2411)" class="text-sm text-zinc-900"
          text "上次检查：今天 09:12 · 已是最新版本" class="text-xs text-zinc-500"
        end
        box class="h-7 items-center justify-center rounded-md bg-zinc-900/10 px-3"
          text "检查更新" class="text-xs font-medium text-zinc-900"
        end
      end
    end
  end
end

design dark in="desktop-settings#dark/page" name="通用 · 深色"
box class="relative flex-1 gap-5 bg-[#0f1017] p-8"
  use ambient-dark class="absolute top-0 right-0 bottom-0 left-0 h-full"
  box class="gap-1"
    text "通用" class="text-2xl font-bold text-zinc-50"
    text "语言、外观、启动行为与更新" class="text-sm text-zinc-400"
  end
  box class="gap-2"
    text "基本" class="px-1 text-xs font-medium text-zinc-400"
    box class="gap-px overflow-hidden rounded-xl border border-white/8 bg-white/7 shadow-sm shadow-black/5"
      box class="h-12 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        text "界面语言" class="flex-1 text-sm text-zinc-50"
        use select-dark label="简体中文"
      end
      box class="h-12 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        text "主题" class="flex-1 text-sm text-zinc-50"
        box class="h-7 flex-row rounded-md bg-zinc-50/5 p-0.5"
          box class="items-center justify-center rounded px-3"
            text "跟随系统" class="text-xs text-zinc-400"
          end
          box class="items-center justify-center rounded bg-[#1a1b25] shadow-sm px-3"
            text "深色" class="text-xs font-medium text-zinc-50"
          end
          box class="items-center justify-center rounded px-3"
            text "浅色" class="text-xs text-zinc-400"
          end
        end
      end
      box class="h-14 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        box class="flex-1 gap-0.5"
          text "默认媒体源" class="text-sm text-zinc-50"
          text "首页与媒体库默认显示的内容来源" class="text-xs text-zinc-400"
        end
        use select-dark label="全部媒体源（聚合）"
      end
    end
  end
  box class="gap-2"
    text "启动" class="px-1 text-xs font-medium text-zinc-400"
    box class="gap-px overflow-hidden rounded-xl border border-white/8 bg-white/7 shadow-sm shadow-black/5"
      box class="h-12 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        text "启动时打开" class="flex-1 text-sm text-zinc-50"
        box class="h-7 flex-row rounded-md bg-zinc-50/5 p-0.5"
          box class="items-center justify-center rounded bg-[#1a1b25] shadow-sm px-3"
            text "首页" class="text-xs font-medium text-zinc-50"
          end
          box class="items-center justify-center rounded px-3"
            text "上次位置" class="text-xs text-zinc-400"
          end
        end
      end
      box class="h-12 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        text "登录时自动启动" class="flex-1 text-sm text-zinc-50"
        use switch-dark variant=off class="h-[22px] w-[38px]" knob.class="size-[18px]"
      end
      box class="h-14 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        box class="flex-1 gap-0.5"
          text "在菜单栏显示图标" class="text-sm text-zinc-50"
          text "关闭主窗口后可从菜单栏继续播放、查看下载进度" class="text-xs text-zinc-400"
        end
        use switch-dark class="h-[22px] w-[38px]" knob.class="size-[18px]"
      end
    end
  end
  box class="gap-2"
    text "更新" class="px-1 text-xs font-medium text-zinc-400"
    box class="gap-px overflow-hidden rounded-xl border border-white/8 bg-white/7 shadow-sm shadow-black/5"
      box class="h-12 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        text "自动检查并下载更新" class="flex-1 text-sm text-zinc-50"
        use switch-dark class="h-[22px] w-[38px]" knob.class="size-[18px]"
      end
      box class="h-14 flex-row items-center gap-4 bg-[#1a1b25] px-4"
        box class="flex-1 gap-0.5"
          text "当前版本 2.4.0 (2411)" class="text-sm text-zinc-50"
          text "上次检查：今天 09:12 · 已是最新版本" class="text-xs text-zinc-400"
        end
        box class="h-7 items-center justify-center rounded-md bg-zinc-50/10 px-3"
          text "检查更新" class="text-xs font-medium text-zinc-50"
        end
      end
    end
  end
end
