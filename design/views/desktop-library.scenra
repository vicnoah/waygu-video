      end
    end
    box class="w-5 items-center gap-1 pt-2" note="按片名拼音首字母快速定位"
      text "#" class="text-[10px] text-zinc-500"
      text "A" class="text-[10px] text-zinc-500"
      text "B" class="text-[10px] font-bold text-violet-500"
      text "C" class="text-[10px] text-zinc-500"
      text "D" class="text-[10px] text-zinc-500"
      text "F" class="text-[10px] text-zinc-500"
      text "G" class="text-[10px] text-zinc-500"
      text "H" class="text-[10px] text-zinc-500"
