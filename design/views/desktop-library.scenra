      end
      box class="flex-row justify-between"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="怒火·重案 海报：对峙的两名警察" title="怒火·重案" sub="2021 · 动作" quality="1080P" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="爱情神话 海报：上海弄堂里的男女" title="爱情神话" sub="2021 · 喜剧" quality="1080P" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="我不是药神 海报：男子手握药瓶" title="我不是药神" sub="2018 · 剧情" quality="1080P" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=watched cover="让子弹飞 海报：三位主角持枪" title="让子弹飞" sub="2010 · 喜剧" card.tap="open desktop-movie"
        use poster class="w-36" cover.class="h-52" variant=fresh cover="霸王别姬 海报：京剧扮相的两人" title="霸王别姬" sub="1993 · 剧情" quality="1080P" card.tap="open desktop-movie"
