      text "L" class="text-[10px] text-zinc-500"
      text "M" class="text-[10px] text-zinc-500"
      text "N" class="text-[10px] text-zinc-500"
      text "Q" class="text-[10px] text-zinc-500"
      text "R" class="text-[10px] text-zinc-500"
      text "S" class="text-[10px] text-zinc-500"
      text "W" class="text-[10px] text-zinc-500"
      text "X" class="text-[10px] text-zinc-500"
      text "Y" class="text-[10px] text-zinc-500"
      text "Z" class="text-[10px] text-zinc-500"
    end
  end
end

design dark in="desktop-main#dark/content" name="电影库 · 深色"
box class="relative flex-1 gap-5 bg-[#0f1017] px-8 pt-6 pb-8"
  use ambient-dark class="absolute top-0 right-0 bottom-0 left-0 h-full"
  box class="flex-row items-center gap-4"
