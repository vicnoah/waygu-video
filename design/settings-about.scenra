        use settings-row-dark icon=file-video title="支持的格式" value="MKV · MP4 · ISO …" badge.class="bg-violet-500" note="视频：MKV、MP4、AVI、TS、ISO、BDMV 等；字幕：ASS、SRT、PGS、VobSub；弹幕：XML、JSON"
        use settings-row-dark icon=message-circle title="反馈问题" value.class="hidden" badge.class="bg-emerald-500"
        use settings-row-dark icon=file-down title="导出日志" value.class="hidden" badge.class="bg-zinc-500" note="打包最近 7 天的日志，可分享给开发者，已去除密码与令牌"
      end
    end
    use settings-group-dark header="调试"
      fill
        use settings-row-dark variant=toggle-off icon=activity title="记录网络日志" badge.class="bg-orange-500"
        use settings-row-dark variant=toggle-off icon=gauge title="播放器信息覆盖层" badge.class="bg-orange-500" note="播放时显示编码、码率、丢帧、缓冲等实时信息"
      end
    end
    use settings-group-dark header="更多"
      fill
        use settings-row-dark icon=star title="去 App Store 评分" value.class="hidden" badge.class="bg-amber-500"
        use settings-row-dark icon=lock title="隐私政策" value.class="hidden" badge.class="bg-zinc-500"
        use settings-row-dark icon=scroll-text title="开源许可" value.class="hidden" badge.class="bg-zinc-500"
      end
    end
    use settings-group-dark variant=noheader
      fill
        box class="h-12 items-center justify-center bg-[#1a1b25]"
          text "重置所有设置" class="text-[15px] text-rose-500"
        end
      end
    end
    text "© 2026 Waygu · 用心看好每一部片" class="text-center text-xs text-zinc-400/70"
  end
end
