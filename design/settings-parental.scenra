      end
    end
    use settings-group-dark header="内容限制"
      fill
        use settings-row-dark icon=badge-alert title="分级上限" value="PG-13" badge.class="bg-rose-500" note="G / PG / PG-13 / R / 不限制；无分级信息的内容按“需要确认”处理"
        use settings-row-dark icon=eye-off title="隐藏的媒体库" value="2 个" badge.class="bg-zinc-500"
        use settings-row-dark icon=server title="允许的媒体源" value="家庭 Emby" badge.class="bg-emerald-500"
        use settings-row-dark variant="toggle-off desc" icon=baby title="儿童模式" desc="只显示动画与家庭分级内容，界面简化" badge.class="bg-pink-500"
      end
    end
    use settings-group-dark header="使用时长" variant=footer footer="到达时长后暂停播放，输入密码可临时延长 30 分钟。"
      fill
        use settings-row-dark variant=toggle icon=hourglass title="每日时长限制" badge.class="bg-indigo-500"
        use settings-row-dark variant=plain title="工作日" value="1 小时"
        use settings-row-dark variant=plain title="周末" value="2 小时"
        use settings-row-dark variant=plain title="禁止观看时段" value="21:30 – 07:00"
      end
    end
  end
end
