      end
    end
    use settings-group-dark header="ASS / SSA" variant=footer footer="开启后保留特效字幕的原始字体、位置与动画；关闭则统一使用上方样式。"
      fill
        use settings-row-dark variant=toggle icon=sparkles title="按原样式渲染 ASS 字幕" badge.class="bg-fuchsia-500"
        use settings-row-dark variant=toggle icon=type title="加载内嵌字体" badge.class="bg-fuchsia-500"
      end
    end
    use settings-group-dark header="在线字幕"
      fill
        use settings-row-dark variant=toggle icon=download title="缺少字幕时自动下载" badge.class="bg-emerald-500"
        use settings-row-dark icon=globe title="OpenSubtitles" value="已登录 · lin_xy" badge.class="bg-emerald-600"
        use settings-row-dark icon=globe title="射手网（伪）" value="已启用" badge.class="bg-blue-500"
        use settings-row-dark icon=globe title="SubHD" value="未启用" badge.class="bg-zinc-500"
        use settings-row-dark icon=folder-open title="外挂字幕匹配" value="同名 + 语言后缀" badge.class="bg-zinc-500" note="识别 movie.zh-CN.ass、movie.chs.srt 等命名的外挂字幕"
      end
    end
  end
end
