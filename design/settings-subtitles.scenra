              box class="size-8 items-center justify-center rounded-full border border-white/8 bg-white ring-2 ring-violet-500 ring-offset-2 ring-offset-card"
                icon check class="size-4 text-black"
              end
              box class="size-8 rounded-full bg-amber-200"
              end
              box class="size-8 rounded-full bg-yellow-300"
              end
              box class="size-8 rounded-full bg-sky-300"
              end
              box class="size-8 rounded-full bg-emerald-300"
              end
              box class="size-8 rounded-full bg-pink-300"
              end
              box class="size-8 items-center justify-center rounded-full border border-white/8"
                icon plus class="size-4 text-zinc-400"
              end
            end
          end
          use settings-row-dark variant=plain title="描边 / 阴影" value="细描边 + 阴影"
