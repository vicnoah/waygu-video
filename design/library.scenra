      use poster-dark title="沙丘2" sub="2024 · 8.3" cover="《沙丘2》海报：沙漠中的人物剪影" variant=fresh card.tap="open movie-detail#dark"
      use poster-dark title="奥本海默" sub="2023 · 8.8" cover="《奥本海默》海报：火焰中的人物" card.tap="open movie-detail#dark"
