      use poster-dark title="绝命毒师" sub="5 季" cover="《绝命毒师》海报：沙漠与房车" variant=watched card.tap="open series-detail#dark"
      use poster-dark title="狂飙" sub="39 集" quality="1080P" cover="《狂飙》海报：鱼摊前的男人" card.tap="open series-detail#dark"
