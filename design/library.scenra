      text "未观看" class="text-xs text-zinc-50/80"
    end
  end
  box class="flex-1 gap-5 px-5 pb-28" panel=movies
    text "1,284 部电影 · 来自 3 个媒体源" class="text-xs text-zinc-400" note="同一部影片在多个媒体源中存在时合并为一项，详情页可选择版本"
