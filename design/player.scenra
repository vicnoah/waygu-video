design device=phone width=844 height=390 name="手机/播放器"
box class="relative flex-1 overflow-hidden bg-zinc-950" note="播放器界面始终为深色，不随亮/暗主题切换"
  image "电影画面：太空电梯在暗蓝色星空下升起，远处是被冰封的地球，冷色科幻光影" class="absolute top-0 right-0 bottom-0 left-0"
  box class="absolute top-0 right-0 left-0 h-28 bg-linear-to-b from-black/75 via-black/35 to-transparent"
  end
  box class="absolute right-0 bottom-0 left-0 h-40 bg-linear-to-t from-black/85 via-black/45 to-transparent"
  end
  box class="absolute top-0 right-0 bottom-0 left-0" note="弹幕层：按时间轴渲染，滚动弹幕从右向左匀速移动，同一轨道不重叠；顶部弹幕居中停留 4 秒。字号、透明度、速度、显示区域取自弹幕面板设置。暂停时弹幕同步暂停。"
    text "前方高能！！！" class="absolute top-[64px] left-[470px] text-[17px] font-semibold text-white"
    text "这段特效真的是国产天花板" class="absolute top-[92px] left-[150px] text-[17px] font-semibold text-white/90"
    text "名场面来了" class="absolute top-[120px] left-[600px] text-[17px] font-semibold text-amber-300"
    text "MOSS：让人类永远保持理智，确实是一种奢求" class="absolute top-[148px] left-[260px] text-[17px] font-semibold text-sky-300"
    text "二刷还是会哭" class="absolute top-[92px] left-[640px] text-[17px] font-semibold text-pink-300"
    text "太空电梯也太震撼了" class="absolute top-[176px] left-[520px] rounded-md border border-violet-400 bg-violet-500/15 px-1.5 text-[17px] font-semibold text-white" note="自己刚发送的弹幕带描边框以示区分"
    text "全体起立 致敬" class="absolute top-[64px] left-[110px] text-[17px] font-semibold text-emerald-300"
  end
  box class="absolute top-0 right-0 left-0 flex-row items-center gap-3 px-6 pt-4"
    box class="size-9 items-center justify-center rounded-full border border-white/10 bg-white/15" tap="close"
      icon chevron-left class="size-5 text-white"
    end
    box class="flex-1 gap-1"
      text "流浪地球2" class="text-base font-semibold text-white"
      box class="flex-row items-center gap-1.5"
        text "2160p" class="rounded bg-white/15 px-1 py-px text-[9px] font-bold text-white"
        text "HDR10" class="rounded bg-amber-400/20 px-1 py-px text-[9px] font-bold text-amber-300"
        text "来自 家庭 Emby" class="text-[11px] text-zinc-300"
      end
    end
    box class="h-9 flex-row items-center gap-1 rounded-full border border-white/10 bg-white/15 px-1"
      box class="size-8 items-center justify-center rounded-full" note="投屏：AirPlay / DLNA / Chromecast，列出局域网可用设备"
        icon cast class="size-[18px] text-white"
      end
      box class="size-8 items-center justify-center rounded-full" note="画中画：返回桌面后继续以小窗播放"
        icon picture-in-picture-2 class="size-[18px] text-white"
      end
      box class="size-8 items-center justify-center rounded-full" note="更多：截图、片段循环、播放信息、跳转章节、音视频同步、睡眠定时"
        icon ellipsis class="size-[18px] text-white"
      end
    end
  end
  box class="absolute top-[166px] left-6 size-10 items-center justify-center rounded-full border border-white/10 bg-black/35" note="锁定屏幕：锁定后隐藏所有控件并屏蔽手势"
    icon lock-open class="size-[18px] text-white"
  end
  box class="absolute top-[156px] left-[322px] flex-row items-center gap-10" note="手势：左侧上下滑调节亮度，右侧上下滑调节音量，横向滑动快进快退，双击暂停/播放，长按 2 倍速播放"
    box class="size-12 items-center justify-center rounded-full border border-white/10 bg-black/30"
      icon rotate-ccw class="size-6 text-white"
      text "10" class="absolute text-[8px] font-bold text-white"
    end
    box class="size-[68px] items-center justify-center rounded-full border border-white/15 bg-white/20 shadow-2xl"
      icon pause class="size-8 text-white"
    end
    box class="size-12 items-center justify-center rounded-full border border-white/10 bg-black/30"
      icon rotate-cw class="size-6 text-white"
      text "10" class="absolute text-[8px] font-bold text-white"
    end
  end
  box class="absolute right-0 bottom-0 left-0 gap-2.5 px-6 pb-4"
    box class="flex-row items-center gap-3"
      text "01:12:34" class="text-xs font-medium text-white"
      box class="relative h-4 flex-1 justify-center" note="进度条：浅色段为已缓冲，竖线为章节分隔；拖动时显示缩略图预览"
        box class="h-1 rounded-full bg-white/20"
        end
        box class="absolute left-0 h-1 w-[62%] rounded-full bg-white/35"
        end
        box class="absolute left-0 h-1 w-[42%] rounded-full bg-linear-to-r from-violet-500 to-fuchsia-500"
        end
        box class="absolute left-[18%] h-1 w-0.5 bg-black/60"
        end
        box class="absolute left-[55%] h-1 w-0.5 bg-black/60"
        end
        box class="absolute left-[80%] h-1 w-0.5 bg-black/60"
        end
        box class="absolute left-[41%] size-3.5 rounded-full bg-white shadow-md shadow-violet-500/50"
        end
      end
      text "02:53:10" class="text-xs font-medium text-zinc-300"
    end
    box class="flex-row items-center gap-2"
      box class="size-9 items-center justify-center"
        icon play class="size-5 text-white"
      end
      box class="size-9 items-center justify-center" note="下一集 / 下一部（播放列表）"
        icon skip-forward class="size-5 text-white"
      end
      box class="h-8 flex-row items-center gap-2 rounded-full border border-white/10 bg-white/15 pr-3 pl-1" note="左侧“弹”为弹幕开关，点右侧输入框弹出键盘发送弹幕（需登录弹弹play）"
        box class="size-6 items-center justify-center rounded-full bg-linear-to-br from-violet-500 to-fuchsia-500"
          text "弹" class="text-[11px] font-bold text-white"
        end
        text "发个友善的弹幕…" class="w-36 text-xs text-zinc-300"
      end
      box class="flex-1"
      end
      box class="h-8 flex-row items-center gap-0.5 rounded-full border border-white/10 bg-white/10 px-1"
        box class="h-7 flex-row items-center gap-1.5 rounded-full px-2.5" tap="open player-danmaku"
          icon sliders-horizontal class="size-4 text-white"
          text "弹幕设置" class="text-xs text-white"
        end
        box class="h-7 flex-row items-center gap-1.5 rounded-full px-2.5" tap="open player-tracks"
          icon captions class="size-4 text-white"
          text "字幕/音轨" class="text-xs text-white"
        end
        box class="h-7 items-center justify-center rounded-full px-2.5" note="倍速：点按循环 1.0x / 1.25x / 1.5x / 2.0x，长按打开完整列表"
          text "1.0x" class="text-xs font-semibold text-white"
        end
        box class="h-7 items-center justify-center rounded-full px-2.5" note="画面比例：原始 / 填充 / 拉伸 / 16:9 / 4:3 / 2.35:1"
          icon scan class="size-4 text-white"
        end
      end
    end
  end
end
