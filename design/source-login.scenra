        fill
          box class="h-12 flex-row items-center gap-3 bg-[#1a1b25] px-4"
            text "用户名" class="w-16 text-[15px] text-zinc-50"
            text "linxiaoyu" class="flex-1 text-[15px] text-zinc-50/80"
          end
          box class="h-12 flex-row items-center gap-3 bg-[#1a1b25] px-4"
            text "密码" class="w-16 text-[15px] text-zinc-50"
            text "••••••••••" class="flex-1 text-[15px] text-zinc-50/80"
            icon eye-off class="size-4 text-zinc-400"
          end
          use settings-row-dark title="使用快速连接码" icon=key-round badge.class="bg-slate-500" value="Quick Connect"
