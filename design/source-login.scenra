          use settings-row-dark title="忽略证书错误" variant="toggle-off plain"
          use settings-row-dark title="备用外网地址" variant=plain value="未设置" note="内网不可达时自动切换到外网地址"
        end
      end
      box class="mx-4 flex-row items-center gap-3 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 p-4"
        icon circle-check class="size-5 text-emerald-500"
        box class="flex-1"
          text "已连接 Emby Server 4.8.10" class="text-sm font-medium text-zinc-50"
          text "延迟 12ms · 局域网 · 已登录为 linxiaoyu" class="text-xs text-zinc-400"
        end
        text "重新测试" class="text-xs text-emerald-500"
