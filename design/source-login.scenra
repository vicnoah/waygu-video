          use settings-row-dark title="剧集" icon=tv value="326 部" chevron=circle-check chevron.class="size-5 text-violet-400"
          use settings-row-dark title="动漫" icon=sparkles value="198 部" chevron=circle-check chevron.class="size-5 text-violet-400"
          use settings-row-dark title="纪录片" icon=globe badge.class="bg-slate-500" value="57 部" chevron=circle chevron.class="size-5 text-zinc-400/60"
        end
      end
    end
    box class="gap-6" panel=jellyfin
      box class="mx-4 items-center gap-2 rounded-2xl border border-white/8 bg-[#1a1b25] p-6 shadow-sm shadow-black/5"
