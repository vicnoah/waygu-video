      box class="flex-row items-center gap-3 bg-[#1a1b25] px-4 py-2.5"
        box class="size-9 items-center justify-center rounded-xl bg-violet-500/12"
          icon server class="size-4 text-violet-400"
        end
        box class="flex-1"
          text "多平台媒体源" class="text-sm font-medium text-zinc-50"
          text "Emby · Jellyfin · 飞牛影视 · Plex · SMB · WebDAV" class="text-xs text-zinc-400"
        end
      end
      box class="flex-row items-center gap-3 bg-[#1a1b25] px-4 py-2.5"
        box class="size-9 items-center justify-center rounded-xl bg-fuchsia-500/12"
          icon message-square-text class="size-4 text-fuchsia-500"
        end
        box class="flex-1"
          text "弹幕同看" class="text-sm font-medium text-zinc-50"
          text "自动匹配弹弹play、B站等弹幕源" class="text-xs text-zinc-400"
        end
      end
      box class="flex-row items-center gap-3 bg-[#1a1b25] px-4 py-2.5"
        box class="size-9 items-center justify-center rounded-xl bg-amber-500/12"
          icon sparkles class="size-4 text-amber-500"
        end
        box class="flex-1"
          text "4K HDR · 杜比视界 · 全景声" class="text-sm font-medium text-zinc-50"
          text "原画直通，无需服务器转码" class="text-xs text-zinc-400"
        end
      end
      box class="flex-row items-center gap-3 bg-[#1a1b25] px-4 py-2.5"
        box class="size-9 items-center justify-center rounded-xl bg-sky-500/12"
          icon cloud class="size-4 text-sky-500"
        end
        box class="flex-1"
          text "iCloud 同步" class="text-sm font-medium text-zinc-50"
          text "媒体源、进度与设置跨设备同步" class="text-xs text-zinc-400"
        end
      end
    end
    box class="mt-auto gap-1 pb-6"
      box class="h-[52px] flex-row items-center justify-center gap-2 rounded-2xl bg-linear-to-r from-violet-500 to-fuchsia-500 shadow-lg shadow-violet-500/30" tap="open add-source#dark"
        icon plus class="size-5 text-white"
        text "添加媒体源" class="text-base font-semibold text-white"
      end
      text "稍后设置" class="py-2 text-center text-sm font-medium text-zinc-400" tap="open home#dark" note="跳过引导，进入空首页，首页会提示添加媒体源"
    end
  end
end
