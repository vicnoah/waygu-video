          end
          box class="h-8 flex-1 flex-row items-center justify-center gap-1.5 rounded-lg border border-white/8 bg-zinc-50/5" tap="open source-login#dark"
            icon pencil class="size-3.5 text-zinc-50/80"
            text "编辑" class="text-xs text-zinc-50/90"
          end
        end
      end
      box class="h-12 flex-row items-center justify-center gap-2 rounded-2xl border border-dashed border-violet-500/50 bg-violet-500/8" tap="open add-source#dark"
        icon plus class="size-5 text-violet-400"
        text "添加媒体源" class="text-[15px] font-medium text-violet-400"
