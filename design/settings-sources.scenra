      box class="gap-3 rounded-2xl border border-white/8 bg-[#1a1b25] shadow-sm shadow-black/5 p-4"
        box class="flex-row items-center gap-3"
          box class="size-11 items-center justify-center rounded-xl bg-sky-500 shadow-md shadow-black/10"
