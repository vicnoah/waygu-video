            icon pencil class="size-3.5 text-zinc-50/80"
            text "编辑" class="text-xs text-zinc-50/90"
          end
        end
      end
      box class="gap-3 rounded-2xl border border-white/8 bg-[#1a1b25] shadow-sm shadow-black/5 p-4"
        box class="flex-row items-center gap-3"
          box class="size-11 items-center justify-center rounded-xl bg-blue-600 shadow-md shadow-black/10"
