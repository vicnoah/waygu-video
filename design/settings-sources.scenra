    end
    use settings-group-dark header="连接"
      fill
        use settings-row-dark variant=toggle icon=power title="启动时自动连接" badge.class="bg-emerald-500"
        use settings-row-dark variant="toggle desc" icon=network title="局域网 / 外网自动切换" desc="在家时优先使用局域网地址，离开后切换到外网地址" badge.class="bg-sky-500"
        use settings-row-dark icon=timer title="连接超时" value="10 秒" badge.class="bg-zinc-500"
      end
