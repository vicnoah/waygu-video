        use settings-row-dark variant=toggle-off icon=headphones title="后台继续播放音频" badge.class="bg-emerald-500"
        use settings-row-dark icon=hard-drive-download title="缓冲大小" value="自动（最多 500 MB）" badge.class="bg-zinc-500"
