    end
    use settings-group-dark header="剧集"
      fill
        use settings-row-dark variant=toggle icon=skip-forward title="自动播放下一集" badge.class="bg-violet-500"
        use settings-row-dark variant=toggle icon=fast-forward title="跳过片头片尾" badge.class="bg-violet-500"
        use settings-row-dark icon=scan-search title="片头片尾识别" value="服务器标记 + 音频指纹" badge.class="bg-violet-500" note="优先使用 Emby / Jellyfin 章节与 Intro Skipper 标记，没有时按同季音频指纹自动识别"
      end
    end
    use settings-group-dark header="控制"
      fill
        use settings-row-dark variant=toggle icon=history title="记住播放进度" badge.class="bg-blue-500"
        use settings-row-dark icon=rotate-ccw title="快退步长" value="10 秒" badge.class="bg-blue-500"
        use settings-row-dark icon=rotate-cw title="快进步长" value="30 秒" badge.class="bg-blue-500"
        use settings-row-dark icon=gauge title="默认倍速" value="1.0x" badge.class="bg-blue-500"
        use settings-row-dark icon=hand title="手势" value="亮度 · 音量 · 进度" badge.class="bg-blue-500"
      end
    end
    use settings-group-dark header="后台与网络"
