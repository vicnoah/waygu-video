      end
    end
    use settings-group-dark header="下载选项"
      fill
        use settings-row-dark icon=film title="下载画质" value="1080p · 10 Mbps" badge.class="bg-violet-500" note="原画下载需服务器允许；其它画质由服务器转码后下载"
        use settings-row-dark variant=toggle icon=wifi title="仅在 Wi-Fi 下下载" badge.class="bg-sky-500"
        use settings-row-dark icon=layers title="同时下载数" value="2" badge.class="bg-indigo-500"
        use settings-row-dark icon=folder title="下载位置" value="本机" badge.class="bg-zinc-500"
        use settings-row-dark variant="toggle desc" icon=trash title="自动删除已看完" desc="看完 24 小时后删除下载文件" badge.class="bg-rose-500"
        use settings-row-dark variant=toggle icon=subtitles title="同时下载字幕与弹幕" badge.class="bg-pink-500"
      end
    end
    use settings-group-dark header="缓存"
      fill
        use settings-row-dark icon=image title="图片缓存上限" value="2 GB" badge.class="bg-sky-500"
        box class="h-12 items-center justify-center bg-[#1a1b25]"
          text "清除图片缓存" class="text-[15px] text-violet-400"
        end
        box class="h-12 items-center justify-center bg-[#1a1b25]"
          text "删除全部下载" class="text-[15px] text-rose-500"
        end
      end
    end
  end
end
