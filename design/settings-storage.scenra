        box class="flex-row items-center gap-3 bg-[#1a1b25] px-4 py-3"
          image "奥本海默 剧照缩略图" class="h-12 w-20 rounded-lg"
          box class="flex-1 gap-1"
            text "奥本海默" class="truncate text-sm text-zinc-50"
            text "已下载 · 1080p · 6.8 GB" class="text-[11px] text-emerald-500"
          end
          icon circle-check class="size-5 text-emerald-500"
